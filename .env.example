# "Ask about me" box — Qualcomm Cloud AI 100 (OpenAI-compatible chat API).
# Leave these unset and the hero box renders its fallback state instead.
AI_BASE_URL=https://aisuite.cirrascale.com/apis/v2
AI_API_KEY=00a0827c-b42c-4160-8a64-5bf5bf04b1d2
AI_MODEL=

# Optional durable rate limiting. Without these the endpoint falls back to
# per-instance in-memory counters (fine for low traffic, resets on cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override the allowed Origin for /api/ask (defaults to the canonical site).
SITE_ORIGIN=https://aayushswami.com
